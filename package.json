{
  "name": "cosmetics-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm ci --only=production",
    "start": "cd server && node src/server.js",
    "docker:build": "docker build -t cosmetics-store .",
    "docker:run": "docker run -p 3000:3000 cosmetics-store"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}